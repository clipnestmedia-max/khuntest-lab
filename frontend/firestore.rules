rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userProfileExists() {
      return signedIn() && exists(userPath());
    }

    function userDoc() {
      return get(userPath());
    }

    function isActiveUser() {
      return userDoc().data.isActive == true
        || userDoc().data.active == true;
    }

    function isAdmin() {
      return userProfileExists()
        && userDoc().data.role == "admin"
        && isActiveUser();
    }

    function isPatient() {
      return userProfileExists()
        && userDoc().data.role == "patient"
        && isActiveUser();
    }

    function isStaff() {
      return userProfileExists()
        && (userDoc().data.role == "staff" || userDoc().data.role == "admin")
        && isActiveUser();
    }

    function sameEmail(email) {
      return userProfileExists()
        && isActiveUser()
        && userDoc().data.email == email;
    }

    function patientOwnsReport() {
      return signedIn()
        && (
          resource.data.patientUid == request.auth.uid
          || resource.data.authUid == request.auth.uid
          || resource.data.userId == request.auth.uid
          || sameEmail(resource.data.patientEmail)
          || sameEmail(resource.data.email)
        );
    }

    function reportIsReleased() {
      return resource.data.reportStatus == "released"
        || resource.data.reportStatus == "Released"
        || resource.data.reportStatus == "Final"
        || resource.data.reportStatus == "final"
        || resource.data.status == "released"
        || resource.data.status == "Released"
        || resource.data.status == "Final"
        || resource.data.status == "final"
        || resource.data.reportReleased == true;
    }

    // Shared WhatsApp report links: the reportShares/{tokenHash} document id
    // IS the SHA-256 hash of the 256-bit random share token, so a client
    // must already know the exact unguessable id to get() it - never a
    // query - and `allow list` stays admin-only so the collection can't be
    // enumerated. Same "unguessable id is the authorization" pattern
    // billAccess/{token} already uses below, extended with an explicit
    // enabled/revoked/expiry check plus a live payment re-check.
    function shareIsActive(share) {
      return share.get('enabled', false) == true
        && share.get('revoked', false) != true
        && (share.get('expiresAt', null) == null || share.expiresAt > request.time);
    }

    function reportShareBookingPaid(tokenHash) {
      let share = get(/databases/$(database)/documents/reportShares/$(tokenHash)).data;
      let bookingId = share.get('bookingId', '');
      let booking = get(/databases/$(database)/documents/bookings/$(bookingId)).data;
      let balance = booking.get('balanceDue', booking.get('dueAmount', 0));
      return booking.get('paymentStatus', '') == 'Paid' && balance <= 0;
    }

    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if isAdmin();
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == "patient";
      allow create: if isAdmin();
      allow read: if isAdmin();
      allow update: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == uid
          && resource.data.role == "patient"
          && request.resource.data.role == "patient"
        );
      allow delete: if isAdmin();
    }

    match /patients/{uid} {
      allow create, read, update: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow create: if isAdmin()
        || (
          request.resource.data.patientEmail is string
          && request.resource.data.patientName is string
          && request.resource.data.phone is string
        )
        || (
          isPatient()
          && request.resource.data.patientEmail == userDoc().data.email
          && request.resource.data.patientName is string
          && request.resource.data.phone is string
        );
      allow read: if isAdmin()
        || sameEmail(resource.data.patientEmail)
        || sameEmail(resource.data.email);
      allow update, delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow get: if isAdmin()
        || (patientOwnsReport() && reportIsReleased());
      allow list: if isAdmin()
        || (
          signedIn()
          && request.query.limit <= 50
          && patientOwnsReport()
          && reportIsReleased()
        );
      allow create, update, delete: if isAdmin();
    }

    // Metadata only (no medical content) - readable by anyone who already
    // has the exact tokenHash (unguessable, 256 bits) so the client can
    // show an accurate invalid/revoked/expired message. `allow list` stays
    // admin-only so the collection itself can never be enumerated.
    match /reportShares/{tokenHash} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Denormalized, sanitized report content for an active share - kept in
    // a separate collection (same tokenHash id) so a client can be told
    // "payment pending" vs "invalid link" without ever touching medical
    // results until payment is confirmed.
    match /reportShareResults/{tokenHash} {
      allow get: if shareIsActive(get(/databases/$(database)/documents/reportShares/$(tokenHash)).data)
        && reportShareBookingPaid(tokenHash);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Access log written by the Cloud Function via the Admin SDK (bypasses
    // rules). Admins may review it; no client ever writes to it directly.
    match /reportShareAccess/{accessId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /bills/{billNo} {
      allow read: if isAdmin()
        || sameEmail(resource.data.patientEmail)
        || (isPatient() && resource.data.patientId == request.auth.uid);
      allow create: if isAdmin()
        || (
          isPatient()
          && (
            request.resource.data.patientId == request.auth.uid
            || request.resource.data.patientEmail == userDoc().data.email
          )
        );
      allow update: if isAdmin()
        || (isPatient() && resource.data.patientId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /billAccess/{token} {
      allow read: if resource.data.publicToken == token;
      allow create, update: if isAdmin()
        || (
          isPatient()
          && (
            request.resource.data.patientId == request.auth.uid
            || request.resource.data.patientEmail == userDoc().data.email
          )
        );
      allow delete: if isAdmin();
    }

    match /machineResults/{machineResultId} {
      allow read, write: if isAdmin();
    }

    match /onlineBookings/{bookingId} {
      allow create: if isPatient()
        && request.resource.data.patientUid == request.auth.uid
        && request.resource.data.patientName is string
        && request.resource.data.phone is string
        && request.resource.data.email == userDoc().data.email;
      allow read: if isAdmin()
        || (isPatient() && resource.data.patientUid == request.auth.uid);
      allow update: if isAdmin()
        || (
          isPatient()
          && resource.data.patientUid == request.auth.uid
          && (resource.data.bookingStatus in ["New", "Pending Confirmation"] || resource.data.status in ["New", "Pending Confirmation"])
          && request.resource.data.patientUid == resource.data.patientUid
        );
      allow delete: if isAdmin();
    }

    match /labAttendants/{attendantId} {
      allow read: if isAdmin()
        || (isStaff() && resource.data.active == true);
      allow create, update: if isAdmin()
        && request.resource.data.labId is string
        && request.resource.data.fullName is string;
      allow delete: if isAdmin();
    }

    match /adminNotifications/{notificationId} {
      allow create: if isPatient()
        && request.resource.data.type == "online_booking"
        && request.resource.data.bookingId is string;
      allow read, update, delete: if isAdmin();
    }

    match /bookingAuditTrail/{auditId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /billAuditTrail/{auditId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /tests/{testId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /packages/{packageId} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow write: if isAdmin();
    }

    // Temporary development-only rules, if needed during setup:
    // match /{document=**} {
    //   allow read, write: if true;
    // }
  }
}
